{
  "name": "cedh-meta-bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.21"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "probe": "tsx scripts/probe.ts",
    "migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "backfill": "tsx --env-file-if-exists=.env scripts/backfill.ts",
    "enrich-sample": "tsx --env-file-if-exists=.env scripts/enrich-sample.ts",
    "quality": "tsx --env-file-if-exists=.env scripts/quality.ts",
    "geocode": "tsx --env-file-if-exists=.env scripts/geocode.ts",
    "classify": "tsx --env-file-if-exists=.env scripts/classify.ts",
    "refresh": "npm run backfill -- --months 2 && npm run classify && npm run standings && npm run geocode && npm run regions && npm run pair-commanders && npm run color-identity",
    "regions": "tsx --env-file-if-exists=.env scripts/regions.ts",
    "report": "tsx --env-file-if-exists=.env scripts/report.ts",
    "preview": "tsx --env-file-if-exists=.env scripts/preview.ts",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "register-commands": "tsx --env-file-if-exists=.env scripts/register-commands.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "standings": "tsx --env-file-if-exists=.env scripts/fetch-standings.ts",
    "optout": "tsx --env-file-if-exists=.env scripts/optout.ts",
    "pair-commanders": "tsx --env-file-if-exists=.env scripts/fetch-pair-commanders.ts",
    "pair-report": "tsx --env-file-if-exists=.env scripts/pair-report.ts",
    "color-identity": "tsx --env-file-if-exists=.env scripts/fetch-color-identity.ts",
    "color-report": "tsx --env-file-if-exists=.env scripts/color-report.ts",
    "places": "tsx --env-file-if-exists=.env scripts/load-populated-places.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/which-polygon": "^2.2.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "next": "16.4.3",
    "postgres": "^3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "which-polygon": "^2.2.1"
  }
}
