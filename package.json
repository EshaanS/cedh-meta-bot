{
  "name": "cedh-meta-bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.21"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "probe": "tsx scripts/probe.ts",
    "migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "backfill": "tsx --env-file-if-exists=.env scripts/backfill.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "postgres": "^3.4.9"
  }
}
